# --- Данные базы данных PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ngo_crm_db

# --- Кэш и Лимитер (Dragonfly подменяет Redis по его же протоколу) ---
REDIS_URL=redis://dragonfly:6379

# --- Безопасность JWT-сессий ---
# Сгенерируй стойкий ключ (например, через openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only when seeding a database without an existing administrator.
INITIAL_ADMIN_PASSWORD=