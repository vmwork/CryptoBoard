# --- Данные базы данных PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=classifyd_db

# Dragonfly / Redis
REDIS_URL=redis://classifyd_cache:6379/0

# Backend security and SIWE
SECRET_KEY=change-me-session-secret-32-chars-minimum
INTERNAL_BFF_SECRET=change-me-internal-bff-secret-32-chars
EVM_RPC_URL=https://arb1.arbitrum.io/rpc
EVM_CHAIN_ID=42161
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost
SESSION_COOKIE_NAME=session_id
NONCE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800